{
  "name": "gdrive-share",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "overrides": {
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18",
    "undici": "7.29.0"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:mock": "vite dev --host 127.0.0.1 --port 4192",
    "check": "react-router typegen && tsc --noEmit",
    "build": "react-router build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bun run test:e2e:fixture && playwright test",
    "test:e2e:fixture": "bun scripts/build-e2e-fixture.ts",
    "test:e2e:headed": "bun run test:e2e:fixture && playwright test --headed",
    "test:watch": "vitest",
    "test:workspace": "vitest run src/lib/workspace-model.test.ts src/lib/list-selection.test.ts src/lib/file-permissions.test.ts src/lib/file-move.test.ts src/lib/workspace-availability.test.ts src/lib/upload-conflicts.test.ts src/lib/mock-workspace-model.test.ts",
    "security:public": "bun scripts/check-public-repo.ts",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint:biome": "biome lint . --diagnostic-level=error",
    "lint:dead": "knip",
    "quality": "bun run format:check && bun run lint:biome && bun run lint && bun run typecheck && bun run lint:dead && bun run test",
    "db:generate": "drizzle-kit generate",
    "bootstrap:google-admin": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap-google-admin.ps1",
    "bootstrap:google-admin:sh": "sh scripts/bootstrap-google-admin.sh",
    "install:gcloud:ps1": "powershell -ExecutionPolicy Bypass -File scripts/install-google-cloud-cli.ps1",
    "install:gcloud:sh": "sh scripts/install-google-cloud-cli.sh",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@react-router/cloudflare": "^8.3.0",
    "@react-router/dev": "^8.3.0",
    "@react-router/node": "^8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "prettier": "latest",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@better-auth/passkey": "^1.7.1",
    "@simplewebauthn/server": "latest",
    "better-auth": "^1.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.2.1",
    "lucide-react": "^1.33.0",
    "motion": "^12.43.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  }
}
