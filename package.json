{
  "name": "gdrive-share",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint:biome": "biome lint . --diagnostic-level=error",
    "lint:dead": "knip",
    "quality": "bun run format:check && bun run lint:biome && bun run lint && bun run typecheck && bun run lint:dead && bun run test",
    "db:generate": "drizzle-kit generate",
    "bootstrap:google-admin": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap-google-admin.ps1",
    "bootstrap:google-admin:sh": "sh scripts/bootstrap-google-admin.sh",
    "install:gcloud:ps1": "powershell -ExecutionPolicy Bypass -File scripts/install-google-cloud-cli.ps1",
    "install:gcloud:sh": "sh scripts/install-google-cloud-cli.sh",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "bun run build && node scripts/prepare-worker.mjs && wrangler deploy",
    "cf-typegen": "wrangler types",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-cloudflare": "latest",
    "@sveltejs/kit": "latest",
    "@sveltejs/vite-plugin-svelte": "latest",
    "@types/node": "latest",
    "drizzle-kit": "^0.31.10",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "eslint-plugin-svelte": "^3.22.0",
    "knip": "^6.29.0",
    "lefthook": "^2.1.10",
    "prettier": "latest",
    "prettier-plugin-svelte": "latest",
    "svelte": "latest",
    "svelte-check": "latest",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@better-auth/passkey": "^1.6.25",
    "@simplewebauthn/server": "latest",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "motion": "^12.42.2"
  }
}
