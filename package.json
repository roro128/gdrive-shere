{
  "name": "gdrive-share",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "check": "react-router typegen && tsc --noEmit",
    "build": "react-router build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:workspace": "vitest run src/lib/workspace-model.test.ts src/lib/list-selection.test.ts src/lib/file-permissions.test.ts src/lib/file-move.test.ts src/lib/workspace-availability.test.ts src/lib/upload-conflicts.test.ts src/lib/mock-workspace-model.test.ts",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint:biome": "biome lint . --diagnostic-level=error",
    "lint:dead": "knip",
    "quality": "bun run format:check && bun run lint:biome && bun run lint && bun run typecheck && bun run lint:dead && bun run test",
    "db:generate": "drizzle-kit generate",
    "bootstrap:google-admin": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap-google-admin.ps1",
    "bootstrap:google-admin:sh": "sh scripts/bootstrap-google-admin.sh",
    "install:gcloud:ps1": "powershell -ExecutionPolicy Bypass -File scripts/install-google-cloud-cli.ps1",
    "install:gcloud:sh": "sh scripts/install-google-cloud-cli.sh",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@cloudflare/vite-plugin": "^1.47.0",
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "^10.0.1",
    "@react-router/cloudflare": "^8.3.0",
    "@react-router/dev": "^8.3.0",
    "@react-router/node": "^8.3.0",
    "@types/node": "latest",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "knip": "^6.29.0",
    "lefthook": "^2.1.10",
    "prettier": "latest",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@better-auth/passkey": "^1.6.25",
    "@simplewebauthn/server": "latest",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "motion": "^12.42.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "isbot": "^5"
  }
}
